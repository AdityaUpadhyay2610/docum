# ─── Backend API Base URL ──────────────────────────────────────────────────────
# No trailing slash. The /api suffix is appended automatically by config.js.
VITE_API_URL=http://localhost:3000

# ─── Origin Guard shared secret ───────────────────────────────────────────────
# Must match APP_REQUEST_TOKEN set in the backend .env (production only).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# VITE_APP_REQUEST_TOKEN=<paste-your-generated-token-here>
