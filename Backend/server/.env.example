# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=your_mongo_url

# ─── JWT Secrets (REQUIRED – server crashes if missing) ───────────────────────
# Use a long random hex string. Never use plain words.
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here

# ─── JWT Lifetimes (optional – defaults shown) ────────────────────────────────
# JWT_ACCESS_EXPIRES_IN=10m
# JWT_REFRESH_EXPIRES_IN=7d

# ─── Environment ──────────────────────────────────────────────────────────────
# Set to "production" on your deployment platform (Render, Railway, etc.)
NODE_ENV=development

# ─── Server Port ──────────────────────────────────────────────────────────────
# The server listens on PORT (default: 3000).
# Update this if your platform assigns a different port.
# PORT=3000

# ─── CORS – comma-separated list of allowed frontend origins ──────────────────
# In production this MUST be set to your Vercel deployment URL(s).
# Example: CLIENT_URL=https://my-app.vercel.app,https://custom-domain.com
# CLIENT_URL=

# ─── Origin Guard shared secret ───────────────────────────────────────────────
# The frontend sends this value in the `X-App-Request` header on every request.
# In production, set this to a long random string and add the SAME value as
# VITE_APP_REQUEST_TOKEN in your frontend environment variables.
#
# APP_REQUEST_TOKEN=<paste-your-generated-token-here>

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# ─── Email / SMTP (for email verification) ────────────────────────────────────
# The server sends a verification email on every password registration.
# If these are not set, the email is skipped and a warning is logged –
# accounts will be permanently unverifiable unless SMTP is configured.
#
# ── Resend (recommended) ──────────────────────────────────────────────────────
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=resend
# EMAIL_PASS=re_YOUR_RESEND_API_KEY          # get from resend.com/api-keys
# EMAIL_FROM=noreply@yourdomain.com
#
# ── Gmail (dev / low volume) ─────────────────────────────────────────────────
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your@gmail.com
# EMAIL_PASS=your_google_app_password        # NOT your account password
# EMAIL_FROM=your@gmail.com
#
# ── Any other SMTP provider ───────────────────────────────────────────────────
# EMAIL_HOST=mail.yourprovider.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=smtp_username
# EMAIL_PASS=smtp_password
# EMAIL_FROM=noreply@yourprovider.com